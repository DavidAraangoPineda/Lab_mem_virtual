# t2_thrash: working set de 8 paginas recorrido en ciclo.
# Con --phys=16384 (4 marcos) el working set no cabe -> thrashing.
# Las escrituras iniciales hacen que las victimas salgan sucias (dirty = 1).
# Como no hay swap, el contenido de una pagina expulsada se pierde: al
# recargarla empieza en ceros.
alloc 32768

# Sembrar las 8 paginas con valores reconocibles.
write 0 10
write 4096 11
write 8192 12
write 12288 13
write 16384 14
write 20480 15
write 24576 16
write 28672 17

# Tres vueltas completas al working set.
read 0
read 4096
read 8192
read 12288
read 16384
read 20480
read 24576
read 28672

read 0
read 4096
read 8192
read 12288
read 16384
read 20480
read 24576
read 28672

read 0
read 4096
read 8192
read 12288
read 16384
read 20480
read 24576
read 28672

# Sin swap: ambas fueron expulsadas desde que se escribieron (10 y 17),
# asi que se perdio su contenido y se leen en 0.
read 0
read 28672

# Liberacion: los marcos vuelven a la lista de libres.
free 0
